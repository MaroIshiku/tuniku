# Tuniku runtime
TZ=Europe/Berlin
# The primary Compose file publishes Tuniku on the assigned host port 65001.
TUNIKU_PORT=8080
TUNIKU_DATA_PATH=/data
TUNIKU_LOG_LEVEL=info
TUNIKU_TRUSTED_PROXY_COUNT=0
HTTPS_ONLY=false

# New installations need one operator-provided setup secret. The primary
# docker-compose.yml exposes this value directly for the ZimaOS editor.
ISHIKU_SETUP_SECRET=replace-with-at-least-32-random-characters

# Hardened alternative used by docker-compose.example.yml:
# ISHIKU_SETUP_SECRET_FILE=/run/secrets/ishiku_setup_secret

# Tuniku generates persistent internal session and credential-encryption keys
# under /data/.secrets. Existing deployments may retain these legacy overrides:
# TUNIKU_SESSION_SECRET_FILE=/run/secrets/tuniku_session_secret
# TUNIKU_ENCRYPTION_KEY_FILE=/run/secrets/tuniku_encryption_key

# Advanced: allow an explicitly configured loopback Gluetun URL.
TUNIKU_ALLOW_LOOPBACK_UPSTREAM=false

# Optional restricted Docker observer endpoint for Gluetun list, inspect, and
# bounded logs. The primary Compose supplies its internal helper automatically.
# TUNIKU_DOCKER_PROXY_URL=http://tuniku-docker-observer:2375
