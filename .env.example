# Tuniku runtime
TZ=Europe/Berlin
# The primary Compose file publishes Tuniku on the assigned host port 65001.
TUNIKU_PORT=8080
TUNIKU_DATA_PATH=/data
TUNIKU_LOG_LEVEL=info
TUNIKU_TRUSTED_PROXY_COUNT=0

# Prefer the Docker Secret files shown in docker-compose.example.yml.
TUNIKU_REGISTRATION_SECRET_FILE=/run/secrets/tuniku_registration_secret
TUNIKU_SESSION_SECRET_FILE=/run/secrets/tuniku_session_secret
TUNIKU_ENCRYPTION_KEY_FILE=/run/secrets/tuniku_encryption_key

# Environment fallbacks for simple local runs only. Never commit real values.
# ISHIKU_SETUP_SECRET=replace-with-a-long-random-value
# TUNIKU_SESSION_SECRET=replace-with-at-least-32-random-characters
# TUNIKU_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-character-hex

# Advanced: allow an explicitly configured loopback Gluetun URL.
TUNIKU_ALLOW_LOOPBACK_UPSTREAM=false

# Optional restricted Docker Socket Proxy HTTP endpoint. GET-only observation.
# TUNIKU_DOCKER_PROXY_URL=http://docker-proxy:2375
